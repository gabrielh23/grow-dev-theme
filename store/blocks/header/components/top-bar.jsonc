{
	"vtex.menu@2.x:menu#top-bar": {
		"children": [
			"menu-item#shop",
			"menu-item#about-us"
		]
	},
	"menu-item#shop": {
		"props": {
			"id": "menu-item-shop",
			"type": "custom",
			"iconId": null,
			"highlight": false,
			"itemProps": {
				"type": "internal",
				"href": "#",
				"noFallow": false,
				"tagTitle": "Shop",
				"text": "Shop"
			}
		}
	},
	"vtex.menu@2.x:menu#institutional": {
		"children": ["menu-item#vtex-website"]
	},
	"menu-item#vtex-website": {
		"props": {
			"id": "menu-item-vtex-website",
			"type": "custom",
			"iconId": null,
			"highlight": false,
			"itemProps": {
				"type": "external",
				"href": "https://vtex.com",
				"noFallow": false,
				"tagTitle": "Vtex Site",
				"text": "Vtex Site"
			}
		}
	}
}